# Broke? — environment variables
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — NEVER commit real keys. Only the anon/public
# keys below are safe in the browser; Supabase row-level security protects data.

# --- Supabase (Auth + Postgres) ---
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Mixpanel (product analytics) ---
# Mixpanel → Settings → Project Settings → Project Token
VITE_MIXPANEL_TOKEN=
# Set to "true" to send analytics to Mixpanel EU residency (default: US)
VITE_MIXPANEL_EU=false
